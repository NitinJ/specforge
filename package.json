{
  "name": "specforge",
  "version": "0.9.0",
  "description": "Spec authoring, browser review, and agent collaboration for Claude Code, Codex, and Pi.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "keywords": ["pi-package", "codex", "claude-code", "spec", "review"],
  "pi": {
    "extensions": ["./pi/index.ts"],
    "skills": ["./skills"],
    "prompts": ["./pi/prompts"]
  },
  "bin": {
    "spec-nav": "lib/spec-nav-cli.mjs",
    "specforge": "lib/specforge-cli.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node --test --test-force-exit",
    "test:e2e": "node --test --test-concurrency=1 test-e2e/*.e2e.mjs"
  },
  "devDependencies": {
    "jsdom": "^29.1.1",
    "mermaid": "^11.16.1",
    "playwright": "^1.60.0",
    "prismjs": "^1.30.0"
  }
}
